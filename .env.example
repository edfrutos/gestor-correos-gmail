# Configuración del servidor remoto (VPN/Local)

# Interfaz de red donde escuchará el servidor.
# - Para uso local estándar: localhost
# - Para VPN (ej. Tailscale): usa tu IP de Tailscale (100.x.y.z)
HOST=localhost

# Puerto de escucha
PORT=8765

# Modo sin navegador (Headless). 
# 1 = No intenta abrir el navegador al iniciar ni en OAuth (imprime URL en consola).
HEADLESS=0

# Orígenes adicionales permitidos para CORS (separados por coma).
# Incluye aquí la IP o nombre de host desde el que accederás si no es localhost.
ALLOWED_ORIGINS=localhost:8765

# (Opcional) Habilitar borrado permanente en Gmail.
ENABLE_PERMANENT_DELETE=0
